{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/server/**/*",
    "src/standalone/**/*",
    "src/sandbox/**/*",
    "src/shared/**/*",
    "packages/**/*",
    "apps/desktop/**/*",
    "apps/service/**/*",
    "native/codeteam-sandbox/index.d.ts"
  ],
  "exclude": ["apps/web/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "allowImportingTsExtensions": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/turn-errors": ["src/shared/turn-errors.ts"],
      "@shared/job-references": ["src/shared/job-references.ts"],
      "@shared/*": ["src/shared/*"],
      "@server/*": ["src/server/*"],
      "@codetask/contracts": ["packages/contracts/src/index.ts"],
      "@codetask/contracts/*": ["packages/contracts/src/*"],
      "@codetask/database": ["packages/database/src/index.ts"],
      "@codetask/database/*": ["packages/database/src/*"],
      "@codetask/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@codetask/agent-runtime/*": ["packages/agent-runtime/src/*"],
      "@codetask/provider-runtime-node": ["packages/provider-runtime-node/src/index.ts"],
      "@codetask/provider-runtime-node/*": ["packages/provider-runtime-node/src/*"],
      "@codetask/server-core": ["packages/server-core/src/index.ts"],
      "@codetask/server-core/*": ["packages/server-core/src/*"],
      "@codetask/service-bootstrap": ["packages/service-bootstrap/src/index.ts"],
      "@codetask/service-bootstrap/*": ["packages/service-bootstrap/src/*"]
    }
  }
}
