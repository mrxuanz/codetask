  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.221",
    "@codetask/agent-runtime": "*",
    "@codetask/contracts": "*",
    "@codetask/provider-spec": "*",
    "@openai/codex-sdk": "^0.146.0",
    "@opencode-ai/sdk": "^1.18.13"
