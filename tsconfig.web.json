{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "apps/web/src/env.d.ts",
    "apps/web/src/**/*",
    "apps/web/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "packages/contracts/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["apps/web/src/*"],
      "@shared/turn-errors": ["src/shared/turn-errors.ts"],
      "@shared/*": ["src/shared/*"],
      "@codetask/contracts": ["packages/contracts/src/index.ts"],
      "@codetask/contracts/*": ["packages/contracts/src/*"]
    }
  }
}
